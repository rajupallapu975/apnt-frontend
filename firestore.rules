rules_version = '2';

// ============================================================================
// CUSTOMER PROJECT RULES  (psfc-43b5a and the two failover projects)
// ----------------------------------------------------------------------------
// Phase 0.1 of BUGFIX_PLAN.md. Replaces the previous `allow read, write: if true`
// on every collection, which made all customer orders, uploaded-document URLs,
// names, emails and FCM tokens world-readable and world-writable to anyone who
// knew the project ID.
//
// The backend uses the Firebase Admin SDK, which bypasses these rules entirely,
// so tightening them constrains only direct client access — which is the point.
//
// Write access is a narrow field allowlist rather than a blanket deny because the
// customer app legitimately writes a few pickup/UI state fields directly
// (FirestoreService.markCodeRevealed, plus the fallback paths used when the
// backend /mark-delivered call fails). Phase 1 moves those onto authenticated
// backend endpoints, after which the update rules below can become `if false`.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Legacy orders were keyed by email rather than uid, and the history screen
    // still queries `where('userId', ==, email)`. Both forms must be accepted or
    // those queries are rejected wholesale.
    function ownsRecord(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.userId == request.auth.token.email ||
        data.userEmail == 'reviewer@zikrint.app' ||
        data.customerName == 'Reviewer User' ||
        data.userId == 'reviewer_user'
      );
    }

    // True when the write touches only the listed fields.
    function changesOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Pickup/scan state the client may set on its own order. Deliberately excludes
    // everything financial or file-related: amount, totalPaid, paymentStatus,
    // printingCost, platformCommission, shopkeeperEarnings, printSettings, fileUrls,
    // publicIds, shopId, userId.
    function clientOrderFields() {
      return [
        'codeRevealed', 'codeRevealedAt',
        'scanned', 'scannedAt',
        'isPicked', 'orderDone',
        'status', 'orderStatus',
        'completedAt'
      ];
    }

    // 🖨️ Xerox orders — the live order collection.
    match /xerox_orders/{orderId} {
      allow read:   if ownsRecord(resource.data);
      allow create: if false;                       // orders are created by the backend only
      allow update: if ownsRecord(resource.data) && changesOnly(clientOrderFields());
      allow delete: if ownsRecord(resource.data);   // FirestoreService.cascadeDeleteOrder
    }

    // 🗄️ Legacy kiosk orders. Retained for older records; no new writes expected.
    match /orders/{orderId} {
      allow read:   if ownsRecord(resource.data);
      allow create: if false;
      allow update: if ownsRecord(resource.data) && changesOnly(clientOrderFields());
      allow delete: if ownsRecord(resource.data);
    }

    // 👤 Users — own profile document only (FCM token registration, display name).
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 🏪 Shops — catalogue data browsed during shop selection. Read-only for clients;
    // all shop mutation happens in the admin project via the backend.
    match /shops/{shopId} {
      allow read:  if true;
      allow write: if false;

      // Any legacy mirror subcollections are backend-only. The client's stray delete of
      // shops/{id}/orders/{id} in this project is wrapped in catchError and is a no-op.
      match /{document=**} {
        allow read:  if true;
        allow write: if false;
      }
    }

    // 📋 Service catalogue — read-only reference data.
    match /services/{serviceId} {
      allow read:  if true;
      allow write: if false;
    }

    match /zikrinter/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // 🔔 Notifications — own notifications only.
    match /notifications/{notificationId} {
      allow read, update, delete: if ownsRecord(resource.data);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ⚙️ App config (service version poll on the upload screen).
    match /app_config/{document} {
      allow read:  if true;
      allow write: if false;
    }

    // Explicit default deny for anything not matched above — including
    // backend-internal collections such as `idempotency` (Phase 1.4).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
